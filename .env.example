# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao
DISCORD_SERVER_ID=id_do_servidor

# Canal onde o painel "Criar Clã" fica publicado (#create-guild)
GUILD_CREATION_CHANNEL_ID=id_do_canal_create_guild

# Cargos com poder administrativo sobre o sistema de clãs.
# Aceita varios IDs separados por virgula. Opcional: quem tem a permissao
# Administrator do Discord ja e tratado como admin.
ADMIN_ROLE_ID=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL="file:../data/guilds.db"

# ---------------------------------------------------------------------------
# Regras do sistema de clãs (tudo configuravel, nada hardcoded)
# ---------------------------------------------------------------------------
GUILD_NAME_MIN_LENGTH=3
GUILD_NAME_MAX_LENGTH=32
GUILD_TAG_MIN_LENGTH=2
GUILD_TAG_MAX_LENGTH=5

GUILD_CATEGORY_PREFIX=⚔️ CLÃ -
GUILD_DEFAULT_TEXT_CHANNEL=💬・chat
GUILD_DEFAULT_VOICE_CHANNEL=🔊・voz
GUILD_ALLOW_CUSTOM_CHANNEL_NAMES=true

# Cargo do clã aparece separado na lista de membros
GUILD_ROLE_HOIST=true
GUILD_ROLE_MENTIONABLE=true

# Coloca [TAG] no apelido do membro (precisa de Manage Nicknames; falhas sao ignoradas)
GUILD_APPLY_TAG_TO_NICKNAME=false

# Limites gerais
GUILD_INVITE_EXPIRATION_MINUTES=1440
GUILD_MAX_MEMBERS=0
GUILD_DRAFT_TTL_MINUTES=10

# Progressao e guerras
GUILD_POINTS_PER_LEVEL=100
GUILD_WAR_PRIZE=50
GUILD_MAX_DESCRIPTION_LENGTH=300
